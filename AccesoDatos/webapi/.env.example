# Reference for deployment environment variables. ASP.NET does not load this file automatically.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5059
ConnectionStrings__DefaultConnection=Server=SQL_HOST;Database=prevencion_accidentes_buses;User Id=RUNTIME_USER;Password=REPLACE_LOCALLY;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=False
JWT_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ISSUER=https://api.example.invalid
JWT_AUDIENCE=https://api.example.invalid
Cors__AllowedOrigins__0=https://panel.example.invalid
AllowedHosts=api.example.invalid
Database__ApplySchemaOnStartup=false
SeedSettings__SeedInitialUsers=false
DataProtection__KeysPath=/var/lib/eunice/data-protection-keys
# Set only when Expo enhanced push security is enabled:
# ExpoPush__AccessToken=REPLACE_LOCALLY
